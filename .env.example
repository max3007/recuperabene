# --- Sviluppo locale ---

# Database SQLite locale (usato quando TURSO_DATABASE_URL non è impostata)
DATABASE_URL="file:./dev.db"

# Chiave API Anthropic per gli insight AI — NON committare il valore reale
ANTHROPIC_API_KEY="sk-ant-..."

# --- Produzione (Vercel) ---
# In produzione il DB è Turso (libSQL): se TURSO_DATABASE_URL è presente,
# l'app la usa al posto del file SQLite. Vedi DEPLOY.md.
# TURSO_DATABASE_URL="libsql://<nome-db>-<org>.turso.io"
# TURSO_AUTH_TOKEN="<token-generato-con-turso-db-tokens-create>"

# Basic Auth perimetrale (middleware). In produzione sono OBBLIGATORIE:
# senza, l'app si blocca (fail-closed). In locale, se assenti, l'auth è disattiva.
# BASIC_AUTH_USER="max"
# BASIC_AUTH_PASSWORD="<una-password-robusta>"

# Fuso orario del runtime. Il server Vercel è UTC: impostarlo rende corretti
# "oggi", streak, giorni-dall'operazione e gli orari dei farmaci per l'Italia.
# TZ="Europe/Rome"
