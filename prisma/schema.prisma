// RecuperaBene — schema Prisma (SQLite)
// Nota: SQLite non supporta gli enum nativi di Prisma.
// mobility e mood sono modellati come String/Int con validazione lato app.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Patient {
  id            String       @id @default(cuid())
  name          String
  operationType String
  operationDate DateTime
  createdAt     DateTime     @default(now())

  medications Medication[]
  checkIns    CheckIn[]
}

model Medication {
  id        String  @id @default(cuid())
  name      String
  // Dose libera, es. "1 compressa", "10 gocce". Opzionale.
  dosage    String?
  // Orari di assunzione come CSV di "HH:MM", es. "08:00,20:00". Vuoto = al bisogno.
  times     String  @default("")
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  // Check-in in cui questo farmaco è stato segnato come assunto
  checkIns CheckIn[]
  // Dosi spuntate come prese (una riga per farmaco/giorno/orario)
  intakes  MedicationIntake[]
}

// Singola dose segnata come presa: presenza della riga = assunta.
model MedicationIntake {
  id           String     @id @default(cuid())
  medicationId String
  medication   Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  // Giorno (mezzanotte locale) a cui si riferisce la dose.
  day          DateTime
  // Orario pianificato "HH:MM" della dose.
  time         String
  createdAt    DateTime   @default(now())

  @@unique([medicationId, day, time])
}

model CheckIn {
  id        String   @id @default(cuid())
  // Giorno del check-in, normalizzato a mezzanotte locale. Uno per giorno per paziente.
  date      DateTime
  painLevel Int // 0–10
  mobility  String // "bed_rest" | "indoors" | "outdoors" | "normal"
  mood      Int // 1–5 (corrisponde alle 5 emoji)
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  // Farmaci assunti in questo check-in
  medications Medication[]

  @@unique([patientId, date])
}
